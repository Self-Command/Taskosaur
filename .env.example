# Taskosaur Configuration Template
# Copy this file to .env and update with your values
#
# For Docker Compose deployment, edit .env in the project root.
# For local dev, edit backend/.env and frontend/.env.local separately.

# ── PostgreSQL ──
POSTGRES_USER=taskosaur
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskosaur

# Database URL (Docker uses service name 'postgres', local uses 'localhost')
DATABASE_URL="postgresql://taskosaur:change-me@localhost:5432/taskosaur"

# ── Application ──
NODE_ENV=development
HOST=0.0.0.0

# ── Auth (generate with: openssl rand -base64 32) ──
JWT_SECRET=change-me-generate-a-random-secret
JWT_REFRESH_SECRET=change-me-generate-another-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=change-me-32-char-hex-string

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Email (SMTP) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@example.com
EMAIL_DOMAIN=example.com

# ── URLs ──
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000
CORS_ORIGIN="http://localhost:3001"
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ── File Upload ──
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760
MAX_EDITOR_IMAGE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
EDITOR_IMAGE_UPLOAD_FOLDER=editor-images

# ── Queue ──
MAX_CONCURRENT_JOBS=5
JOB_RETRY_ATTEMPTS=3
BULL_BOARD_EMAIL=admin@example.com
BULL_BOARD_PASSWORD=change-me

# ── AWS S3 (optional) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# ── PushGo (optional) ──
PUSHGO_CHANNEL_ID=
PUSHGO_CHANNEL_PASSWORD=

# ── Docker build mirrors (China users) ──
# APT_MIRROR=http://mirrors.aliyun.com
# NPM_REGISTRY=https://registry.npmmirror.com
